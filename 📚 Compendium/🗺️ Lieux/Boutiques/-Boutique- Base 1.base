formulas:
  Carte: image(note["🗺️ Carte"])
views:
  - type: table
    name: Tableau
    filters:
      and:
        - file.inFolder("📚 Compendium/🗺️ Lieux/Boutiques")
        - '!file.name.contains(".base")'
    order:
      - file.name
      - 👾 Type
      - ✨ Ambiance
      - 👨 Tenancier
    sort:
      - property: formula.Carte
        direction: DESC
    rowHeight: tall
    columnSize:
      formula.Carte: 128
