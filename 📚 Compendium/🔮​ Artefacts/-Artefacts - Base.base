formulas:
  Sans titre: image(note["🖼️ Portrait"])
properties:
  formula.Sans titre:
    displayName: Portrait
views:
  - type: table
    name: Tableau
    filters:
      and:
        - file.inFolder("📚 Compendium/🔮​ Artefacts")
        - '!file.name.contains(".base")'
        - '!file.inFolder("📚 Compendium/🔮​ Artefacts/Objets")'
    order:
      - formula.Sans titre
      - file.name
      - 💎 Rareté
      - 💰 Prix
      - 📍Lieux
      - Description
      - ✨ Effet
    sort:
      - property: 🖼️ Portrait
        direction: ASC
    columnSize:
      formula.Sans titre: 86
