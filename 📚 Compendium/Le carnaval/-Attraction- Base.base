formulas:
  Portrait: image(note["🖼️ Portrait"])
views:
  - type: table
    name: Tableau
    filters:
      and:
        - '!file.name.contains(".base")'
        - file.inFolder("📚 Compendium/Le carnaval")
        - file.name.contains("🎡")
    order:
      - formula.Portrait
      - file.name
      - 🧬 Race
      - 🎂 Age
      - ❤️ État
      - 🛠️ Occupation
      - 📍Lieux
      - 🤝 Faction
    sort:
      - property: formula.Portrait
        direction: DESC
      - property: 🧬 Race
        direction: ASC
    rowHeight: tall
    columnSize:
      formula.Portrait: 83
      file.name: 99
      note.🎂 Age: 73
      note.🛠️ Occupation: 120
